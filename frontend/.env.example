# NEXT_PUBLIC_* инлайнятся в бандл при `next build` — меняются только пересборкой.
# Локально: скопируйте в .env.local. В проде передаётся build-arg'ом в deploy.yml.

# Отправка писем из UI (кнопки «Отправить КП», кампании, каналы рассылки).
# false = кнопки серые с пометкой «скоро» (решение партнёра для беты, см. lib/outreach.ts).
NEXT_PUBLIC_OUTREACH_SENDING_ENABLED=true

# OAuth-вход (docs/guides/OAUTH_SETUP.md). Каждая кнопка — своим флагом;
# NEXT_PUBLIC_* инлайнятся ПРИ СБОРКЕ фронта → задаются в Coolify.
NEXT_PUBLIC_OAUTH_ENABLED=false
NEXT_PUBLIC_OAUTH_VK=false
NEXT_PUBLIC_OAUTH_YANDEX=false
# Юзернейм бота для Telegram Login Widget (домен spinlid.ru у @BotFather)
NEXT_PUBLIC_TELEGRAM_LOGIN_BOT=
