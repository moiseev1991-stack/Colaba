ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# --- База: в Docker используйте хост ``postgres``; uvicorn на хосте — ``127.0.0.1`` и порт Postgres (в compose обычно 5433:5432).
DATABASE_URL=postgresql+asyncpg://leadgen_user:leadgen_password@postgres:5432/leadgen_db
DATABASE_URL_SYNC=postgresql://leadgen_user:leadgen_password@postgres:5432/leadgen_db
# Локальный бэкенд без Docker-сети, Postgres только через ``docker compose up -d postgres``:
# DATABASE_URL=postgresql+asyncpg://leadgen_user:leadgen_password@127.0.0.1:5433/leadgen_db
# DATABASE_URL_SYNC=postgresql://leadgen_user:leadgen_password@127.0.0.1:5433/leadgen_db

REDIS_URL=redis://redis:6379/0
# Локально: redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Поисковые провайдеры
# По умолчанию используется DuckDuckGo (бесплатный, без ключа)
# Для использования Яндекс XML API (опционально) раскомментируйте и заполните:

# Yandex Cloud Search API (провайдер «Яндекс XML»)
# https://yandex.cloud/ru/docs/search-api/quickstart
# YANDEX_XML_FOLDER_ID=идентификатор_каталога
# YANDEX_XML_KEY=API-ключ_сервисного_аккаунта

# SerpAPI (deprecated - используйте DuckDuckGo или Yandex XML)
# SERPAPI_KEY=your_serpapi_key

# Прокси для HTML-провайдеров (Яндекс, Google) — обход блокировок
# USE_PROXY=true
# PROXY_URL=http://proxy.example.com:8080
# PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080,socks5://proxy3.example.com:1080

# --- LLM (для модуля reviews_ai: sentiment, embeddings, naming кластеров болей) ---
# Прямой OpenAI блокируется для RU IP. Используем ProxyAPI (https://proxyapi.ru) —
# российский шлюз с OpenAI-совместимым API. Ключ один для OpenAI- и Anthropic-роутов.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# --- Приём заявок (Telegram-бот-приёмник + форма лендинга spinlid-team.ru) ---
# Секрет для заголовка X-Inbound-Secret на POST /api/v1/inbound-leads. Тот же
# секрет вписывается в бот и в форму лендинга. Пусто → endpoint отвечает 503.
# INBOUND_SECRET=сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
# chat_id владельца для TG-уведомлений о заявках (узнать у @userinfobot).
# OWNER_TG_CHAT_ID=123456789
# Токен бота (тот же для outreach и приёма). Пусто → бот и TG-уведомления не работают.
# TELEGRAM_BOT_TOKEN=123456:AA...
# Cloudflare Worker-relay для Bot API (прод-ДЦ в РФ не достаёт api.telegram.org напрямую).
# Пусто → шлём напрямую (локалка/дев). X-Relay-Key — общий секрет с воркером.
# TELEGRAM_RELAY_URL=https://colaba-tg-relay.<subdomain>.workers.dev
# TELEGRAM_RELAY_KEY=сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
# SMTP Timeweb для писем-уведомлений и рассылки (пароль хранить только в проде).
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# SMTP_USER=dmitry@spinlid-team.ru
# SMTP_PASSWORD=
# Публичный URL админки для ссылки на заявку в уведомлениях (напр. https://spinlid.ru).
# ADMIN_PUBLIC_URL=
